import java.util.Stack;

class Solution {
    public int longestValidParentheses(String s) {
        Stack<Integer> stack = new Stack<>();
        // Push -1 as a base for the first valid substring calculation
        stack.push(-1);
        int maxLength = 0;

        for (int i = 0; i < s.length(); i++) {
            if (s.charAt(i) == '(') {
                // Always push the index of an opening parenthesis
                stack.push(i);
            } else {
                // If we see ')', pop the last opening bracket or the base
                stack.pop();
                
                if (stack.isEmpty()) {
                    // If stack is empty, this ')' is a boundary; push its index as the new base
                    stack.push(i);
                } else {
                    // Current valid length is current index minus the new top of stack
                    maxLength = Math.max(maxLength, i - stack.peek());
                }
            }
        }
        
        return maxLength;
    }
}
