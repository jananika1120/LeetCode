class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        // 1. Create a dummy node to handle edge cases like removing the head
        ListNode dummy = new ListNode(0);
        dummy.next = head;
        
        ListNode fast = dummy;
        ListNode slow = dummy;

        // 2. Move fast pointer so there is a gap of n nodes between fast and slow
        for (int i = 0; i <= n; i++) {
            fast = fast.next;
        }

        // 3. Move both pointers until fast reaches the end
        // slow will now be right before the node we want to remove
        while (fast != null) {
            fast = fast.next;
            slow = slow.next;
        }

        // 4. Skip the nth node
        slow.next = slow.next.next;

        return dummy.next;
    }
}
