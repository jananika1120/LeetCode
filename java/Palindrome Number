class Solution {
    public boolean isPalindrome(int x) {
        // Special cases:
        // x < 0 is not a palindrome.
        // If the last digit is 0, the first digit must also be 0 (only 0 itself works).
        if (x < 0 || (x % 10 == 0 && x != 0)) {
            return false;
        }

        int revertedNumber = 0;
        while (x > revertedNumber) {
            revertedNumber = revertedNumber * 10 + x % 10;
            x /= 10;
        }

        // For odd lengths, we can get rid of the middle digit by revertedNumber / 10
        // For example, 121: at the end of the loop x = 1, revertedNumber = 12.
        return x == revertedNumber || x == revertedNumber / 10;
    }
}
