class Solution {
    public int divide(int dividend, int divisor) {
        // 1. Handle overflow case: -2^31 / -1 = 2^31 (which overflows)
        if (dividend == Integer.MIN_VALUE && divisor == -1) {
            return Integer.MAX_VALUE;
        }

        // 2. Determine the sign of the result
        boolean negative = (dividend < 0) ^ (divisor < 0);

        // 3. Work with negative numbers to avoid overflow when converting MIN_VALUE to positive
        // Math.abs(Integer.MIN_VALUE) overflows, but negative numbers cover the full range
        long lDividend = Math.abs((long) dividend);
        long lDivisor = Math.abs((long) divisor);

        int quotient = 0;

        // 4. Exponential search (binary lifting)
        while (lDividend >= lDivisor) {
            long tempDivisor = lDivisor;
            int multiple = 1;

            // Double the divisor until it's larger than the remaining dividend
            while (lDividend >= (tempDivisor << 1)) {
                tempDivisor <<= 1;
                multiple <<= 1;
            }

            lDividend -= tempDivisor;
            quotient += multiple;
        }

        return negative ? -quotient : quotient;
    }
}
