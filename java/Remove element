class Solution {
    public int removeElement(int[] nums, int val) {
        // k tracks the position for the next element NOT equal to val
        int k = 0;
        
        for (int i = 0; i < nums.length; i++) {
            // If current element is not the target value
            if (nums[i] != val) {
                // Move it to the front at index k
                nums[k] = nums[i];
                k++;
            }
        }
        
        // k is the count of elements that are not equal to val
        return k;
    }
}
