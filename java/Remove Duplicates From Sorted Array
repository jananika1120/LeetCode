class Solution {
    public int removeDuplicates(int[] nums) {
        if (nums.length == 0) return 0;

        // 1. 'insertIndex' tracks where the next unique element should be placed
        int insertIndex = 1;

        // 2. Iterate through the array starting from the second element
        for (int i = 1; i < nums.length; i++) {
            // 3. If the current element is different from the previous one, it's unique
            if (nums[i] != nums[i - 1]) {
                nums[insertIndex] = nums[i];
                insertIndex++;
            }
        }

        // 4. 'insertIndex' represents the count of unique elements
        return insertIndex;
    }
}
